# JheckBot Environment Variables
# Copy this file to .env and fill in all required values.
# Never commit the real .env file.

NODE_ENV=development

# Ports
API_PORT=8801
WEB_PORT=8800
POSTGRES_HOST_PORT=8802

# Database — required
# Use a strong password. Generate one with: openssl rand -hex 16
DATABASE_URL=postgresql://jheckbot:CHANGE_ME@127.0.0.1:8802/jheckbot
POSTGRES_DB=jheckbot
POSTGRES_USER=jheckbot
POSTGRES_PASSWORD=CHANGE_ME

# Session — required
# Generate with: openssl rand -hex 32
# Must be at least 32 characters.
SESSION_SECRET=CHANGE_ME

# Agent CLI — required
# Can be a command name (if on PATH) or an absolute path.
# Examples: devin, /usr/local/bin/devin
DEVIN_BIN=devin

# tmux — required
# Can be a command name (if on PATH) or an absolute path.
TMUX_BIN=tmux

# Allowed workspace roots — required
# Colon-separated (use ; on Windows). Each root must be an existing directory.
# Projects must be inside one of these roots and contain a .git folder.
# Example: /workspace/projects
ALLOWED_ROOTS=CHANGE_ME

# Admin user — required
# Created on first startup if no users exist.
# Password must be at least 12 characters and must not equal the username.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS — origin allowed to call the API
CORS_ORIGIN=http://localhost:8800

# Proxy hops between the API and the client (1 for Nuxt dev proxy or Cloudflare Tunnel).
TRUST_PROXY=1

# Web Push notifications — optional
# Generate with: npx web-push generate-vapid-keys
# When set, task-completion push notifications are sent to subscribed devices.
# When unset, push notifications are disabled (the app still works normally).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Screenshots — optional
# Where agent-captured screenshots (Playwright/Puppeteer MCP) are stored.
# Defaults to <repo-root>/data/screenshots. Passed to the agent as
# JHECKBOT_SCREENSHOTS_DIR along with JHECKBOT_CONVERSATION_ID so the
# agent can save PNGs that JheckBot surfaces inline in the chat.
# SCREENSHOTS_DIR=/workspace/personal/jheckbot/data/screenshots
