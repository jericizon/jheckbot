# JheckBot Environment Variables
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

NODE_ENV=development

# Ports
API_PORT=8801
WEB_PORT=8800
POSTGRES_HOST_PORT=8802

# Database
DATABASE_URL=postgresql://jheckbot:change-me-locally@127.0.0.1:8802/jheckbot
POSTGRES_DB=jheckbot
POSTGRES_USER=jheckbot
POSTGRES_PASSWORD=change-me-locally

# Session
SESSION_SECRET=generate-and-store-locally

# Devin CLI
DEVIN_BIN=/home/jeric/.local/bin/devin

# tmux — installed at /usr/bin/tmux
TMUX_BIN=/usr/bin/tmux

# Allowed workspace roots (colon-separated)
ALLOWED_ROOTS=/home/jeric/Workspace

# Agent limits
AGENT_MAX_RUNTIME_MS=3600000
AGENT_MAX_CONCURRENT_SESSIONS=3

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Seed admin credentials (used only on first startup when no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
